# Copy to .env and fill in
ANTHROPIC_API_KEY=
EXA_API_KEY=

# Optional: People Data Labs. Leave USE_PDL=false to use the LinkedIn extension for people.
USE_PDL=false
PDL_API_KEY=
PDL_MAX_PEOPLE=10

CLAUDE_MODEL=claude-opus-5-5
DB_PATH=lead_research.db
API_PORT=8765

# Used in the insights (fit score) and in email sign-offs
SENDER_NAME=
SENDER_TITLE=
SENDER_COMPANY=
SENDER_OFFERING=

# Email sending. Leave SMTP_HOST empty for drafts only.
#   Gmail:          SMTP_HOST=smtp.gmail.com      SMTP_PORT=587  (SMTP_PASSWORD = a Google App Password)
#   Microsoft 365:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  (admin may need to enable SMTP AUTH)
# SMTP_SECURITY is starttls for port 587, ssl for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
